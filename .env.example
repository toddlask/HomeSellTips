# Copy to .env.local for local development. Leave values empty when you do not have them.
# Never commit real secrets.

# Single admin secret for /admin. Unset means the admin page says it is not configured.
ADMIN_TOKEN=

# Stripe test secret only. Keys that do not start with sk_test_ are refused. Live mode is not supported.
STRIPE_SECRET_KEY=

# Set to true to take half off the first month of monthly sponsor products. Default off.
LAUNCH_PROMO=

# AdSense publisher id, for example ca-pub-1234567890123456. Empty means no ad slots and an ads.txt with no publisher line.
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_IN_CONTENT=
ADSENSE_SLOT_SIDEBAR=

# Affiliate links stay hidden unless this is true AND the matching URL is set.
AFFILIATES_ENABLED=
AFFILIATE_MOVING_BOXES_URL=
AFFILIATE_HOME_WARRANTY_URL=
AFFILIATE_STAGING_SUPPLIES_URL=

# Set to true on the GitHub Action to open a review item instead of publishing. Default off.
REVIEW_REQUIRED=

# Public site URL for canonical links, sitemap, and Open Graph. Each host should set its own.
NEXT_PUBLIC_SITE_URL=
